{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-vocab-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "vocab.ryanmuenker.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOCABULARY",
        "class_name": "VocabularyCompanion"
      }
    ]
  },
  "exports": {
    "VocabularyCompanion": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // Every 15 minutes, not daily: enqueueDailyReview is a silent ticker that
  // prepares at most one prompt and stays quiet unless work is genuinely due,
  // so frequent ticks are what let a failed send be retried the same day.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "TELEGRAM_ALLOWED_CHAT_ID",
      "TELEGRAM_ALLOWED_USER_ID",
      "OPENCODE_API_KEY"
    ]
  },
  "vars": {
    "OPENCODE_BASE_URL": "https://opencode.ai/zen/go/v1",
    "OPENCODE_MODEL": "deepseek-v4-flash",
    "HERMES_TIMEZONE": "Asia/Kuala_Lumpur",
    "HERMES_REVIEW_HOUR": "12"
  }
}
